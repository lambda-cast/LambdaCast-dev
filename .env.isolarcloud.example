# ─────────────────────────────────────────────────────────────────────────────
# LambdaCast — iSolarCloud Bridge Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.isolarcloud and fill in your values.
# Reference it from docker-compose.yml with: env_file: .env.isolarcloud
#
# Where to get these credentials:
#   1. Log in to the iSolarCloud developer portal:
#      https://developer.isolarcloud.com
#   2. Create a new application to receive your APP_KEY, SECRET_KEY, APP_ID.
#   3. Add your callback URL to the allowed redirect URIs in the portal.
# ─────────────────────────────────────────────────────────────────────────────

# ── iSolarCloud OAuth Application Credentials ────────────────────────────────
# Obtained from the iSolarCloud developer portal (https://developer.isolarcloud.com)
ISOLARCLOUD_APP_KEY=your-app-key-here
ISOLARCLOUD_SECRET_KEY=your-secret-key-here
ISOLARCLOUD_APP_ID=your-app-id-here

# ── OAuth Redirect URI ────────────────────────────────────────────────────────
# Must match exactly what you registered in the developer portal.
# Format: http://<your-machine-ip-or-hostname>:8000/callback
#
# - Use your LAN IP (e.g. 192.168.1.50) when running Docker on a home server
#   and opening the OAuth URL from another device on the same network.
# - Use "localhost" only if your browser runs on the same machine as Docker.
# - Do NOT use a trailing slash.
BRIDGE_REDIRECT_URI=http://localhost:8000/callback

# ── Token Persistence ────────────────────────────────────────────────────────
# Path inside the container where the OAuth token is saved.
# The default matches the /data volume mount — do not change unless you know why.
TOKEN_FILE=/data/isolarcloud_token.json

# ── Plant ID ─────────────────────────────────────────────────────────────────
# The iSolarCloud plant (installation) ID to monitor.
# Find it via GET /api/plants on the bridge after authenticating,
# or from the URL in your iSolarCloud web portal.
ISOLARCLOUD_PLANT_ID=your-plant-id-here
