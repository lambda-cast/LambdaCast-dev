# ─────────────────────────────────────────────────────────────────────────────
# LambdaCast — Main Application Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values before starting the stack.
# Never commit your .env file to version control.
#
# Usage with Docker Compose:
#   cp .env.example .env
#   # edit .env
#   docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin account (created automatically on first launch) ────────────────────
# Change these before the first start — they cannot be easily changed afterwards
# without manually editing the database.
SUNALYZER_ADMIN_USER=admin
SUNALYZER_ADMIN_EMAIL=admin@yourdomain.com
SUNALYZER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Security ──────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens. Use a long random string (32+ chars).
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SUNALYZER_SECRET_KEY=change-me-to-a-random-secret-key

# JWT token lifetime in seconds (default: 86400 = 24 hours)
TOKEN_LIFETIME_S=86400

# ── IQAir API ─────────────────────────────────────────────────────────────────
# Used to fetch real-time AQI_US values for the forecast feature set.
# Get your free key at: https://www.iqair.com/dashboard/api
IQAIR_API_KEY=your-iqair-api-key-here
